{
  "name": "mcp-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed, offline single-page viewer for any MCP server (ReScript + React).",
  "scripts": {
    "res:build": "rescript build",
    "res:watch": "rescript build -w",
    "res:clean": "rescript clean",
    "dev": "vite",
    "build": "rescript build && vite build && vite build --config vite.lib.config.js",
    "build:html": "rescript build && vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "preview": "vite preview",
    "test": "rescript build && vitest run",
    "test:watch": "vitest",
    "validate:live": "node scripts/validate-live.mjs",
    "bundle": "npm run build && node scripts/copy-bundle.mjs"
  },
  "dependencies": {
    "@glennsl/rescript-fetch": "0.3.0",
    "@rescript/react": "0.15.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rescript": "12.3.1"
  },
  "devDependencies": {
    "@jihchi/vite-plugin-rescript": "7.2.0",
    "jsdom": "^27.4.0",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.2"
  }
}
