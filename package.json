{
  "name": "@refactorful/mcp-explorer",
  "version": "0.1.2",
  "type": "module",
  "description": "Offline single-page debugger for any MCP server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Refactorful/mcp-explorer.git"
  },
  "homepage": "https://github.com/Refactorful/mcp-explorer#readme",
  "bugs": {
    "url": "https://github.com/Refactorful/mcp-explorer/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-debugger",
    "debugger",
    "tools",
    "prompts",
    "resources",
    "json-rpc",
    "streamable-http",
    "viewer",
    "explorer",
    "rescript",
    "react"
  ],
  "files": [
    "bundle/mcpexplorer"
  ],
  "main": "bundle/mcpexplorer/index.js",
  "style": "bundle/mcpexplorer/styles.css",
  "unpkg": "bundle/mcpexplorer/index.js",
  "jsdelivr": "bundle/mcpexplorer/index.js",
  "exports": {
    ".": "./bundle/mcpexplorer/index.js",
    "./index.js": "./bundle/mcpexplorer/index.js",
    "./styles.css": "./bundle/mcpexplorer/styles.css",
    "./icon.svg": "./bundle/mcpexplorer/icon.svg",
    "./index.html": "./bundle/mcpexplorer/index.html",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "res:build": "rescript build",
    "res:watch": "rescript build -w",
    "res:clean": "rescript clean",
    "dev": "vite",
    "build": "rescript build && vite build && vite build --config vite.lib.config.js",
    "build:html": "rescript build && vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "preview": "vite preview",
    "test": "rescript build && vitest run",
    "test:watch": "vitest",
    "validate:live": "node scripts/validate-live.mjs",
    "bundle": "npm run build && node scripts/copy-bundle.mjs",
    "prepublishOnly": "npm run bundle"
  },
  "devDependencies": {
    "@glennsl/rescript-fetch": "0.3.0",
    "@jihchi/vite-plugin-rescript": "7.2.0",
    "@rescript/react": "0.15.0",
    "jsdom": "^27.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rescript": "12.3.1",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.2"
  }
}
